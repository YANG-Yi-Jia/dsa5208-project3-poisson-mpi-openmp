#!/bin/bash
#PBS -N poisson_validation
#PBS -q parallel
#PBS -l select=1:ncpus=12:mpiprocs=4:ompthreads=3:mem=2gb
#PBS -l walltime=00:20:00
#PBS -j oe

set -e

cd "$PBS_O_WORKDIR"

module purge
module load openmpi/4.1.2
module load gcc/9.2.0
module load python3.7

export OMP_NUM_THREADS=1
export OMP_DYNAMIC=FALSE
python3 --version

echo "===== JOB INFORMATION ====="
echo "Job ID: $PBS_JOBID"
hostname
date
module list

echo "===== SERIAL AND MPI VALIDATION ====="
bash scripts/run_hpc_validation.sh

echo "===== HYBRID COMPILATION ====="
make hybrid CXX=g++ MPICXX=mpicxx

echo "===== HYBRID VALIDATION ====="
python3 tests/test_hybrid.py

echo "===== ALL TESTS FINISHED ====="
date
